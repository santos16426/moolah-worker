# Moolah API origin, without a trailing endpoint path
MOOLAH_API_URL=http://localhost:4000

# Must exactly match AUTO_POST_WORKER_SECRET on the API.
# Generate independently per environment: openssl rand -base64 32
AUTO_POST_WORKER_SECRET=dev-only-worker-secret-change-me-32

# Optional execution controls
WORKER_TIMEOUT_MS=15000
WORKER_MAX_ATTEMPTS=3
